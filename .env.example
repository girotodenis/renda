# =============================================================================
# Configuração do Google — copie este arquivo para `.env` (gitignored) e
# preencha os valores. NUNCA comite segredos reais.
#
# Em desenvolvimento o Vite lê `.env` / `.env.local` automaticamente.
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATÓRIO — Client ID do OAuth 2.0 (Google Identity Services)
# -----------------------------------------------------------------------------
# Como obter no Google Cloud Console:
#   1. Acesse https://console.cloud.google.com/ e crie/selecione um projeto.
#   2. Em "APIs e serviços" → "Biblioteca", ative:
#        - Google Sheets API
#        - Google Drive API
#   3. Em "APIs e serviços" → "Tela de permissão OAuth", configure o app
#      (tipo "Externo") e adicione seu usuário como "Usuário de teste".
#   4. Em "APIs e serviços" → "Credenciais" → "Criar credenciais" →
#      "ID do cliente OAuth" → tipo "Aplicativo da Web".
#   5. Em "Origens JavaScript autorizadas", adicione a origem do app
#      (ex.: http://localhost:5173 durante o desenvolvimento).
#   6. Copie o "ID do cliente" (termina com .apps.googleusercontent.com).
VITE_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# OPCIONAL — Chave de API do Google Picker
# -----------------------------------------------------------------------------
# Necessária apenas para SELECIONAR uma planilha EXISTENTE no Drive.
# A criação de uma planilha nova funciona só com o Client ID acima.
#
# Como obter:
#   1. Em "APIs e serviços" → "Biblioteca", ative a "Google Picker API".
#   2. Em "Credenciais" → "Criar credenciais" → "Chave de API".
#   3. Restrinja a chave às APIs "Google Picker API" e "Google Drive API".
VITE_GOOGLE_PICKER_API_KEY=

# -----------------------------------------------------------------------------
# OPCIONAL — Número do projeto do Google Cloud
# -----------------------------------------------------------------------------
# Usado como `appId` do Google Picker. Geralmente igual ao prefixo numérico do
# seu Client ID (os dígitos antes de "-"). Deixe em branco se não souber.
VITE_GOOGLE_PROJECT_NUMBER=
